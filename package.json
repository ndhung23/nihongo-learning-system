{
  "name": "nihongo-learning-system",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "db:import-jlpt-tests": "node scripts/import-jlpt-tests-to-mongodb.mjs",
    "db:sync-jlpt-courses": "node scripts/sync-jlpt-test-courses.mjs",
    "data:add-n5-highlights": "node scripts/add-n5-question-highlights.mjs",
    "db:seed-course-learners": "node scripts/seed-course-learner-counts.mjs",
    "db:import-minna-1998-personal": "node scripts/import-minna-1998-personal-lessons.mjs",
    "security:check-data": "node scripts/check-private-data.mjs",
    "dev": "node --max-old-space-size=2048 ./node_modules/next/dist/bin/next dev",
    "dev:webpack": "node --max-old-space-size=2048 ./node_modules/next/dist/bin/next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:i18n": "eslint app/flashcards/i18n/core.js app/flashcards/i18n/LanguageProvider.tsx app/flashcards/components/AppShell.tsx app/flashcards/components/DictionaryPanel.tsx app/flashcards/components/GachaDailyPanel.tsx app/flashcards/components/AiChatbox.tsx app/flashcards/components/PaymentTopUpModal.tsx app/flashcards/screens/LibraryScreen.tsx app/flashcards/discover/page.tsx app/flashcards/bookmarks/page.tsx app/flashcards/kana/[script]/KanaQuiz.tsx app/flashcards/roadmaps/RoadmapsClient.tsx app/flashcards/tests/page.tsx tests/i18n.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:i18n": "node --test tests/i18n.test.mjs",
    "check:i18n": "npm run test:i18n && npm run lint:i18n && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.2",
    "@tiptap/extension-color": "^3.29.2",
    "@tiptap/extension-highlight": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/extension-text-style": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "next": "16.2.10",
    "nodemailer": "^9.0.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "react-icons": "^5.7.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
